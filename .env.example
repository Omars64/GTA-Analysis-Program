# Reference only: configure these in Vercel or your shell environment.
# Never expose server secrets through VITE_* variables.
# Local SQLite mode requires none of these.

# Required in hosted mode
DATABASE_URL=
GTA_APP_PASSWORD=
GTA_SESSION_SECRET=
CRON_SECRET=

# Optional SMTP. Gmail requires an app password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Optional: comma-separated cross-origin clients. Omit for same-origin Vercel.
GTA_CORS_ORIGINS=
# Optional local runtime data directory
# GTA_DATA_DIR=C:/path/to/private/runtime
