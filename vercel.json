{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "frontend", "rewrites": [{ "source": "/settings", "destination": "/index.html" }, { "source": "/history", "destination": "/index.html" }] },
    "api": {
      "root": "backend",
      "entrypoint": "pyproject.toml",
      "functions": { "*.py": { "maxDuration": 300 } }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/settings", "destination": { "service": "web", "path": "/index.html" } },
    { "source": "/history", "destination": { "service": "web", "path": "/index.html" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
